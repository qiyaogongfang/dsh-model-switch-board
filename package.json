{
  "name": "dsh-model-switch-board",
  "version": "0.2.1",
  "description": "DSH 实验性插件：把任务按复杂/一般/简单路由到不同模型，并在侧栏查看每个对话的模型参与情况（半成品）。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "llm-router", "ollama", "dashboard"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiyaogongfang/dsh-model-switch-board.git"
  },
  "homepage": "https://github.com/qiyaogongfang/dsh-model-switch-board#readme",
  "bugs": {
    "url": "https://github.com/qiyaogongfang/dsh-model-switch-board/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
